# IP da interface do host para publicar a aplicação (padrão: somente loopback).
SIGNAGE_BIND_IP=127.0.0.1

# Porta HTTP publicada no host; a porta interna do container permanece 8000.
SIGNAGE_PORT=8080

# Banco SQLite no volume persistente do container.
DATABASE_URL=sqlite:////app/data/signage.db

# Limites de arquivo em MiB (1 MiB = 1024 * 1024 bytes), medidos na leitura.
MAX_VIDEO_UPLOAD_MB=250
MAX_IMAGE_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000

# Limites adicionais por imagem, incluindo GIF/WebP animados.
MAX_IMAGE_FRAMES=100
MAX_IMAGE_TOTAL_PIXELS=100000000
FFPROBE_TIMEOUT_SECONDS=15
