# IP da interface do host para publicar a aplicação (padrão: somente loopback).
SIGNAGE_BIND_IP=127.0.0.1

# Porta HTTP publicada no host; a porta interna do container permanece 8000.
SIGNAGE_PORT=8080

# Banco SQLite no volume persistente do container.
DATABASE_URL=sqlite:////app/data/signage.db

# Limites de arquivo em MiB (1 MiB = 1024 * 1024 bytes), medidos na leitura.
MAX_VIDEO_UPLOAD_MB=250
MAX_IMAGE_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000

# Limites adicionais por imagem, incluindo GIF/WebP animados.
MAX_IMAGE_FRAMES=100
MAX_IMAGE_TOTAL_PIXELS=100000000
FFPROBE_TIMEOUT_SECONDS=15

# HTTPS obrigatório por padrão. O binding não é alterado automaticamente.
SESSION_COOKIE_SECURE=true
LOCAL_AUTH_TEST_MODE=false
# Somente IPs explícitos de proxy TLS confiável, decidido pelo operador; nunca *.
# Vazio: Uvicorn não confia em cabeçalhos X-Forwarded-* de nenhum cliente.
FORWARDED_ALLOW_IPS=

# Timeouts em segundos; mutações autorizadas renovam atividade a cada 5 minutos.
# Leituras GET não escrevem no banco nem renovam o prazo de inatividade.
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
SESSION_TOUCH_SECONDS=300
LOGIN_CHALLENGE_SECONDS=600
# Limites por conta e por origem real (sem confiar no X-Forwarded-For do cliente).
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_ACCOUNT_ATTEMPTS=5
LOGIN_ORIGIN_ATTEMPTS=20

# Exceção temporária para teste: operador configura manualmente binding
# 127.0.0.1:8080 + SESSION_COOKIE_SECURE=false + LOCAL_AUTH_TEST_MODE=true,
# sem proxy confiável, e acessa somente por túnel SSH. Nunca HTTP na LAN.
